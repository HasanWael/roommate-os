rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Check if user is a member of the apartment
    function isApartmentMember(apartmentId) {
      return exists(/databases/$(database)/documents/apartmentMembers/$(apartmentId + '_' + request.auth.uid));
    }

    function isApartmentAdmin(apartmentId) {
      let memberPath = /databases/$(database)/documents/apartmentMembers/$(apartmentId + '_' + request.auth.uid);
      return exists(memberPath) && get(memberPath).data.role == 'admin';
    }

    function isGlobalAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "hwmk2004@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isGlobalAdmin() || 
             (isAuthenticated() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isGlobalAdmin();
    }

    match /apartments/{apartmentId} {
      allow create: if isAuthenticated();
      allow get: if isAuthenticated();
      allow update: if isAuthenticated() && (isApartmentMember(apartmentId) || resource.data.createdBy == request.auth.uid);
      allow list: if false;
      allow delete: if isAuthenticated();
    }

    match /inviteCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (isApartmentAdmin(resource.data.apartmentId) || isAdmin());
    }

    match /apartmentMembers/{memberId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      allow read: if isAuthenticated();
      
      allow update: if isAuthenticated() && (
        (memberId.matches(".*_" + request.auth.uid) && request.resource.data.role == resource.data.role) ||
        isApartmentAdmin(resource.data.apartmentId) ||
        isAdmin()
      );

      allow delete: if isAuthenticated() && (
        memberId.matches(".*_" + request.auth.uid) || 
        isApartmentAdmin(resource.data.apartmentId) ||
        isAdmin()
      );
    }

    match /expenses/{expenseId} {
      allow create: if isAuthenticated() && isApartmentMember(request.resource.data.apartmentId);
      allow read, update, delete: if isAuthenticated() && (isApartmentMember(resource.data.apartmentId) || isAdmin());
    }

    match /expenseSplits/{splitId} {
      // We'd need to check the expense's apartment, but for simplicity, allow if user is involved or if we denormalize apartmentId
      allow read, write: if isAuthenticated() || isAdmin(); // TODO: tighten this
    }

    match /chores/{choreId} {
      allow create: if isAuthenticated() && isApartmentMember(request.resource.data.apartmentId);
      allow read, update, delete: if isAuthenticated() && (isApartmentMember(resource.data.apartmentId) || isAdmin());
    }

    match /groceries/{groceryId} {
      allow create: if isAuthenticated() && isApartmentMember(request.resource.data.apartmentId);
      allow read, update, delete: if isAuthenticated() && (isApartmentMember(resource.data.apartmentId) || isAdmin());
    }

    match /calendarEvents/{eventId} {
      allow create: if isAuthenticated() && isApartmentMember(request.resource.data.apartmentId);
      allow read, update, delete: if isAuthenticated() && (isApartmentMember(resource.data.apartmentId) || isAdmin());
    }

    match /announcements/{announcementId} {
      allow create: if isAuthenticated() && isApartmentMember(request.resource.data.apartmentId);
      allow read, update, delete: if isAuthenticated() && (isApartmentMember(resource.data.apartmentId) || isAdmin());
    }
  }
}
